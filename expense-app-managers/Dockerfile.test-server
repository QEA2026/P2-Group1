FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /workspace

COPY expense-app-managers/pom.xml .
COPY expense-app-managers/src ./src

RUN mvn clean package -DskipTests


FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build \
    /workspace/target/expense-app-managers-1.0-SNAPSHOT.jar \
    app.jar

COPY expense-app-managers/src/test/resources/testDatabase.db \
    /app/testDatabase.db

RUN mkdir -p /var/lib/expense-data

EXPOSE 5001

ENV DATABASE_PATH=/var/lib/expense-data/testDatabase.db

ENTRYPOINT ["sh", "-c", "\
if [ ! -f /var/lib/expense-data/testDatabase.db ]; then \
    cp /app/testDatabase.db /var/lib/expense-data/testDatabase.db; \
fi && \
java -jar app.jar /var/lib/expense-data/testDatabase.db \
"]